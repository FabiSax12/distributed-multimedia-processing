# Copiar a .env.local y ajustar. Todas las variables son opcionales.

# --- Desarrollo (npm run dev) ---
# Hacia dónde hace proxy Vite las llamadas a /api/* (REST + WebSocket).
#   Coordinador corriendo en la laptop:
# VITE_PROXY_TARGET=http://localhost:8000
#   Coordinador desplegado en AWS (pasa por CloudFront, que agrega X-Origin-Verify):
VITE_PROXY_TARGET=https://dydlv3ysi1cxu.cloudfront.net

# --- Overrides (normalmente se dejan vacíos) ---
# Base de la API REST. Vacío = mismo origen (/api/...).
VITE_API_BASE=
# URL del WebSocket de estado en vivo. Vacío = se deriva del origen actual:
#   https://<cloudfront>/  ->  wss://<cloudfront>/api/ws
#   http://localhost:5173/ ->  ws://localhost:5173/api/ws (proxy de Vite -> coordinador)
# Ejemplo explícito contra un coordinador local:
# VITE_WS_URL=ws://localhost:8000/api/ws
VITE_WS_URL=

# Buckets de S3 que el proxy de Vite expone en /__s3/<bucket> (solo desarrollo;
# los buckets solo tienen CORS para el dominio de CloudFront).
VITE_S3_BUCKETS=dmp-dev-dataset,dmp-dev-results
